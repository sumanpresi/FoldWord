<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_blue"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:subtitleTextColor="@color/brand_tagline"
        app:titleTextColor="@color/white" />

    <TextView
        android:id="@+id/pdfMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/banner_bg"
        android:padding="10dp"
        android:text="@string/pdf_view_only"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/banner_ink" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pdfPages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />
</LinearLayout>
