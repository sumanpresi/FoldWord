<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Uses the phone's trusted certificate authorities; no custom or user-added CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
